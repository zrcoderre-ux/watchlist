# Files in the repo root that must NOT be served as public static assets.
# (The Worker's [assets] directory is the repo root, so without this the whole
# repo — including .git — would be publicly downloadable.)
.git
.github
.wrangler
node_modules
.gitignore
.assetsignore
.dev.vars
worker.js
wrangler.toml
package.json
package-lock.json
*.md
